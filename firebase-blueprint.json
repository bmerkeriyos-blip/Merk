{
  "entities": {
    "UserProfileCloud": {
      "title": "UserProfileCloud",
      "description": "Authenticated student ninja profile and progression stats. Clients must write FieldValue.serverTimestamp() for createdAt and updatedAt.",
      "type": "object",
      "properties": {
        "userId": { "type": "string", "description": "Owner Firebase Auth UID" },
        "displayName": { "type": "string" },
        "username": { "type": "string" },
        "email": { "type": "string" },
        "university": { "type": "string" },
        "department": { "type": "string" },
        "academicYear": { "type": "string" },
        "xp": { "type": "integer" },
        "level": { "type": "integer" },
        "ninjaTitle": { "type": "string" },
        "currentStreak": { "type": "integer" },
        "longestStreak": { "type": "integer" },
        "onboardingCompleted": { "type": "boolean" },
        "photoUrl": { "type": "string" },
        "lastActiveDate": { "type": "string" },
        "createdAt": { "type": "string", "format": "date-time" },
        "updatedAt": { "type": "string", "format": "date-time" }
      },
      "required": [
        "userId", "displayName", "username", "email", "university",
        "department", "academicYear", "xp", "level", "ninjaTitle",
        "currentStreak", "longestStreak", "onboardingCompleted", "createdAt", "updatedAt"
      ]
    },
    "CloudTask": {
      "title": "CloudTask",
      "description": "University schedule event, study session, assignment, or exam mission.",
      "type": "object",
      "properties": {
        "userId": { "type": "string" },
        "title": { "type": "string" },
        "notes": { "type": "string" },
        "subjectName": { "type": "string" },
        "category": { "type": "string", "enum": ["CLASS", "STUDY", "ASSIGNMENT", "EXAM", "DEADLINE", "PERSONAL", "BREAK", "EXERCISE"] },
        "dateIso": { "type": "string" },
        "startTimeMinutes": { "type": "integer" },
        "endTimeMinutes": { "type": "integer" },
        "priority": { "type": "string", "enum": ["LOW", "MEDIUM", "HIGH", "CRITICAL"] },
        "missionRank": { "type": "string", "enum": ["D", "C", "B", "A", "S"] },
        "recurrence": { "type": "string", "enum": ["NONE", "DAILY", "WEEKLY", "WEEKDAYS"] },
        "location": { "type": "string" },
        "reminderOffsets": { "type": "string" },
        "xpReward": { "type": "integer" },
        "colorHex": { "type": "string" },
        "completed": { "type": "boolean" },
        "subtasksSummary": { "type": "string" },
        "completedAtIso": { "type": "string" },
        "createdAt": { "type": "string", "format": "date-time" },
        "updatedAt": { "type": "string", "format": "date-time" }
      },
      "required": [
        "userId", "title", "category", "dateIso", "startTimeMinutes", "endTimeMinutes",
        "priority", "missionRank", "recurrence", "xpReward", "colorHex", "completed",
        "createdAt", "updatedAt"
      ]
    },
    "CloudSubject": {
      "title": "CloudSubject",
      "description": "Academic subject or course.",
      "type": "object",
      "properties": {
        "userId": { "type": "string" },
        "name": { "type": "string" },
        "code": { "type": "string" },
        "instructor": { "type": "string" },
        "room": { "type": "string" },
        "colorHex": { "type": "string" },
        "targetHoursPerWeek": { "type": "integer" },
        "createdAt": { "type": "string", "format": "date-time" },
        "updatedAt": { "type": "string", "format": "date-time" }
      },
      "required": ["userId", "name", "code", "colorHex", "targetHoursPerWeek", "createdAt", "updatedAt"]
    },
    "CloudStudySession": {
      "title": "CloudStudySession",
      "description": "Completed Pomodoro, custom focus, stopwatch, or exam prep session.",
      "type": "object",
      "properties": {
        "userId": { "type": "string" },
        "subjectName": { "type": "string" },
        "mode": { "type": "string", "enum": ["POMODORO", "CUSTOM", "STOPWATCH", "EXAM_PREP"] },
        "durationMinutes": { "type": "integer" },
        "xpEarned": { "type": "integer" },
        "startedAtEpochMs": { "type": "integer" },
        "taskId": { "type": "string" },
        "createdAt": { "type": "string", "format": "date-time" },
        "updatedAt": { "type": "string", "format": "date-time" }
      },
      "required": ["userId", "subjectName", "mode", "durationMinutes", "xpEarned", "startedAtEpochMs", "createdAt", "updatedAt"]
    },
    "CloudAchievement": {
      "title": "CloudAchievement",
      "description": "Ninja rank badge or milestone achievement.",
      "type": "object",
      "properties": {
        "userId": { "type": "string" },
        "title": { "type": "string" },
        "description": { "type": "string" },
        "badgeCode": { "type": "string" },
        "unlocked": { "type": "boolean" },
        "xpBonus": { "type": "integer" },
        "createdAt": { "type": "string", "format": "date-time" },
        "updatedAt": { "type": "string", "format": "date-time" }
      },
      "required": ["userId", "title", "description", "badgeCode", "unlocked", "xpBonus", "createdAt", "updatedAt"]
    },
    "CloudSettings": {
      "title": "CloudSettings",
      "description": "Synced user preferences, theme preset, timezone, and Ethiopian calendar toggles.",
      "type": "object",
      "properties": {
        "userId": { "type": "string" },
        "themePreset": { "type": "string" },
        "appearanceMode": { "type": "string" },
        "timezoneId": { "type": "string" },
        "use24HourClock": { "type": "boolean" },
        "useEthiopianCalendar": { "type": "boolean" },
        "showDualCalendar": { "type": "boolean" },
        "aiPersonality": { "type": "string" },
        "animationsEnabled": { "type": "boolean" },
        "reduceMotion": { "type": "boolean" },
        "hapticsEnabled": { "type": "boolean" },
        "floatingAiEnabled": { "type": "boolean" },
        "createdAt": { "type": "string", "format": "date-time" },
        "updatedAt": { "type": "string", "format": "date-time" }
      },
      "required": [
        "userId", "themePreset", "appearanceMode", "timezoneId",
        "use24HourClock", "useEthiopianCalendar", "showDualCalendar",
        "aiPersonality", "animationsEnabled", "reduceMotion", "hapticsEnabled",
        "floatingAiEnabled", "createdAt", "updatedAt"
      ]
    },
    "CloudChat": {
      "title": "CloudChat",
      "description": "AI Ninja Mentor conversation thread.",
      "type": "object",
      "properties": {
        "userId": { "type": "string" },
        "title": { "type": "string" },
        "personality": { "type": "string" },
        "lastMessagePreview": { "type": "string" },
        "createdAt": { "type": "string", "format": "date-time" },
        "updatedAt": { "type": "string", "format": "date-time" }
      },
      "required": ["userId", "title", "personality", "lastMessagePreview", "createdAt", "updatedAt"]
    },
    "CloudChatMessage": {
      "title": "CloudChatMessage",
      "description": "Single message inside an AI Ninja Mentor conversation.",
      "type": "object",
      "properties": {
        "userId": { "type": "string" },
        "chatId": { "type": "string" },
        "role": { "type": "string", "enum": ["user", "model"] },
        "content": { "type": "string" },
        "actionSummary": { "type": "string" },
        "createdAt": { "type": "string", "format": "date-time" },
        "updatedAt": { "type": "string", "format": "date-time" }
      },
      "required": ["userId", "chatId", "role", "content", "createdAt", "updatedAt"]
    },
    "CloudNote": {
      "title": "CloudNote",
      "description": "Study note linked to subject or task.",
      "type": "object",
      "properties": {
        "userId": { "type": "string" },
        "title": { "type": "string" },
        "content": { "type": "string" },
        "subjectName": { "type": "string" },
        "linkedTaskId": { "type": "string" },
        "createdAt": { "type": "string", "format": "date-time" },
        "updatedAt": { "type": "string", "format": "date-time" }
      },
      "required": ["userId", "title", "content", "subjectName", "createdAt", "updatedAt"]
    },
    "CloudBackup": {
      "title": "CloudBackup",
      "description": "Manual or automatic snapshot summary record.",
      "type": "object",
      "properties": {
        "userId": { "type": "string" },
        "summary": { "type": "string" },
        "taskCount": { "type": "integer" },
        "xpSnapshot": { "type": "integer" },
        "createdAt": { "type": "string", "format": "date-time" },
        "updatedAt": { "type": "string", "format": "date-time" }
      },
      "required": ["userId", "summary", "taskCount", "xpSnapshot", "createdAt", "updatedAt"]
    }
  },
  "firestore": {
    "/users/{userId}": {
      "schema": { "$ref": "#/entities/UserProfileCloud" },
      "description": "User profile and progression document"
    },
    "/users/{userId}/tasks/{taskId}": {
      "schema": { "$ref": "#/entities/CloudTask" },
      "description": "User study tasks, classes, and exams"
    },
    "/users/{userId}/subjects/{subjectId}": {
      "schema": { "$ref": "#/entities/CloudSubject" },
      "description": "User university courses and subjects"
    },
    "/users/{userId}/studySessions/{sessionId}": {
      "schema": { "$ref": "#/entities/CloudStudySession" },
      "description": "User focus and Pomodoro study session logs"
    },
    "/users/{userId}/achievements/{achievementId}": {
      "schema": { "$ref": "#/entities/CloudAchievement" },
      "description": "User unlocked shinobi achievements"
    },
    "/users/{userId}/settings/{settingId}": {
      "schema": { "$ref": "#/entities/CloudSettings" },
      "description": "User synced appearance, region, and AI preferences"
    },
    "/users/{userId}/chats/{chatId}": {
      "schema": { "$ref": "#/entities/CloudChat" },
      "description": "User AI mentor chat threads"
    },
    "/users/{userId}/chatMessages/{messageId}": {
      "schema": { "$ref": "#/entities/CloudChatMessage" },
      "description": "User AI mentor chat messages"
    },
    "/users/{userId}/notes/{noteId}": {
      "schema": { "$ref": "#/entities/CloudNote" },
      "description": "User study notes"
    },
    "/users/{userId}/backups/{backupId}": {
      "schema": { "$ref": "#/entities/CloudBackup" },
      "description": "User cloud backup snapshots"
    }
  }
}
